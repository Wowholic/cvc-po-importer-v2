# Reads customers, items, payment terms, and delivery methods, and can save a draft sales order.
# Scopes must stay ZohoBooks.contacts.READ,ZohoBooks.settings.READ,ZohoBooks.salesorders.CREATE.
# Use accounts.zoho.eu and www.zohoapis.eu when Books is on the EU domain.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
ZOHO_API_DOMAIN=www.zohoapis.com

PORT=8080

# One shared login for the desk. AUTH_SECRET is a random signing key, not a password.
# Generate it with: openssl rand -hex 32
AUTH_USER=
AUTH_PASSWORD=
AUTH_SECRET=
